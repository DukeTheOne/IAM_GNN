{
  "metadata": {
    "version": "1.0.0",
    "snapshot_date": "2026-10-07",
    "source": "AWS Service Authorization Reference",
    "services": ["iam", "sts", "lambda", "ec2", "s3", "kms"],
    "description": "Versioned AWS Action-Resource-Condition Capability Model for Tier 1 Prototype & Thesis"
  },
  "global_condition_keys": [
    "aws:CurrentTime",
    "aws:EpochTime",
    "aws:MultiFactorAuthPresent",
    "aws:PrincipalArn",
    "aws:PrincipalAccount",
    "aws:PrincipalOrgID",
    "aws:PrincipalTag/*",
    "aws:PrincipalType",
    "aws:RequestedRegion",
    "aws:SecureTransport",
    "aws:SourceArn",
    "aws:SourceIp",
    "aws:TagKeys",
    "aws:TokenIssueTime",
    "aws:UserAgent",
    "aws:userId",
    "aws:username"
  ],
  "actions": {
    "iam:passrole": {
      "action": "iam:PassRole",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": [
        "iam:PassedToService",
        "iam:AssociatedResourceArn"
      ]
    },
    "iam:createaccesskey": {
      "action": "iam:CreateAccessKey",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["user"],
      "condition_keys": []
    },
    "iam:deleteaccesskey": {
      "action": "iam:DeleteAccessKey",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["user"],
      "condition_keys": []
    },
    "iam:attachrolepolicy": {
      "action": "iam:AttachRolePolicy",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": [
        "iam:PolicyARN"
      ]
    },
    "iam:attachuserpolicy": {
      "action": "iam:AttachUserPolicy",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["user"],
      "condition_keys": [
        "iam:PolicyARN"
      ]
    },
    "iam:detachrolepolicy": {
      "action": "iam:DetachRolePolicy",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": [
        "iam:PolicyARN"
      ]
    },
    "iam:putrolepolicy": {
      "action": "iam:PutRolePolicy",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": []
    },
    "iam:putuserpolicy": {
      "action": "iam:PutUserPolicy",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["user"],
      "condition_keys": []
    },
    "iam:setdefaultpolicyversion": {
      "action": "iam:SetDefaultPolicyVersion",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["policy"],
      "condition_keys": []
    },
    "iam:createpolicyversion": {
      "action": "iam:CreatePolicyVersion",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["policy"],
      "condition_keys": []
    },
    "iam:listroles": {
      "action": "iam:ListRoles",
      "service": "iam",
      "wildcard_only": true,
      "resource_types": [],
      "condition_keys": []
    },
    "iam:getaccountauthorizationdetails": {
      "action": "iam:GetAccountAuthorizationDetails",
      "service": "iam",
      "wildcard_only": true,
      "resource_types": [],
      "condition_keys": []
    },
    "iam:getuser": {
      "action": "iam:GetUser",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["user"],
      "condition_keys": []
    },
    "iam:getrole": {
      "action": "iam:GetRole",
      "service": "iam",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": []
    },
    "sts:assumerole": {
      "action": "sts:AssumeRole",
      "service": "sts",
      "wildcard_only": false,
      "resource_types": ["role"],
      "condition_keys": [
        "sts:RoleSessionName",
        "sts:ExternalId",
        "sts:TransitiveTagKeys"
      ]
