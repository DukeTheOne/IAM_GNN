      "action": "lambda:CreateFunction",
      "service": "lambda",
      "wildcard_only": false,
      "resource_types": ["function"],
      "condition_keys": [
        "lambda:Principal",
        "lambda:Layer"
      ]
    },
    "lambda:invokefunction": {
      "action": "lambda:InvokeFunction",
      "service": "lambda",
      "wildcard_only": false,
      "resource_types": ["function"],
      "condition_keys": [
        "lambda:Payload"
      ]
    },
    "lambda:updatefunctioncode": {
      "action": "lambda:UpdateFunctionCode",
      "service": "lambda",
      "wildcard_only": false,
      "resource_types": ["function"],
      "condition_keys": []
    },
    "ec2:runinstances": {
      "action": "ec2:RunInstances",
      "service": "ec2",
      "wildcard_only": false,
      "resource_types": ["instance", "image", "subnet", "security-group", "key-pair", "volume"],
      "condition_keys": [
        "ec2:InstanceType",
        "ec2:Region",
        "ec2:Tenancy"
      ]
    },
    "ec2:describeinstances": {
      "action": "ec2:DescribeInstances",
      "service": "ec2",
      "wildcard_only": true,
      "resource_types": [],
      "condition_keys": []
    },
    "s3:getobject": {
      "action": "s3:GetObject",
      "service": "s3",
      "wildcard_only": false,
      "resource_types": ["object"],
      "condition_keys": [
        "s3:ExistingObjectTag/*",
        "s3:VersionId"
      ]
    },
    "s3:putobject": {
      "action": "s3:PutObject",
      "service": "s3",
      "wildcard_only": false,
      "resource_types": ["object"],
      "condition_keys": [
        "s3:RequestObjectTag/*",
        "s3:x-amz-server-side-encryption"
      ]
    },
    "s3:listbucket": {
      "action": "s3:ListBucket",
      "service": "s3",
      "wildcard_only": false,
      "resource_types": ["bucket"],
      "condition_keys": [
        "s3:prefix",
        "s3:delimiter"
      ]
    },
    "s3:deleteobject": {
      "action": "s3:DeleteObject",
      "service": "s3",
      "wildcard_only": false,
      "resource_types": ["object"],
      "condition_keys": [
        "s3:VersionId"
      ]
    },
    "kms:decrypt": {
      "action": "kms:Decrypt",
      "service": "kms",
      "wildcard_only": false,
      "resource_types": ["key"],
      "condition_keys": [
        "kms:EncryptionContext:*",
        "kms:ViaService"
      ]
    },
    "kms:generatedatakey": {
      "action": "kms:GenerateDataKey",
      "service": "kms",
      "wildcard_only": false,
      "resource_types": ["key"],
      "condition_keys": [
        "kms:KeySpec",
        "kms:EncryptionContext:*"
      ]
    },
    "kms:describekey": {
      "action": "kms:DescribeKey",
      "service": "kms",
      "wildcard_only": false,
      "resource_types": ["key"],
      "condition_keys": []
    }
